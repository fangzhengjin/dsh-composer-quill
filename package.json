{
  "name": "dsh-composer-quill",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "description": "Ghost completion for the DeepSeek Harness composer: predicts your next message and completes what you are typing.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/dsh-composer-quill.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
















































