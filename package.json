{
  "name": "dsh-composer-quill",
  "version": "0.31.11",
  "type": "module",
  "description": "Quill: completion for the DeepSeek Harness composer: predicts your next message and completes what you are typing.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yugyq/dsh-composer-quill.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "assets",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "homepage": "https://github.com/yugyq/dsh-composer-quill#readme",
  "bugs": {
    "url": "https://github.com/yugyq/dsh-composer-quill/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer",
    "autocomplete",
    "completion",
    "ghost-text",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node smoke-test.mjs",
    "test:ui": "python dev/verify_daily.py",
    "test:all": "node smoke-test.mjs && python dev/verify_daily.py",
    "test:log": "node dev/summarize-log.mjs 1"
  }
}
